{
  "manifest_version": 3,
  "name": "Better Gemini",
  "version": "1.2.11",
  "description": "Customize Gemini: hide the chat bar, track usage limits, see context use, and keep parallel message versions. Not affiliated with Google.",
  "homepage_url": "https://github.com/SmartWorksLabs/Better-Gemini",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["content.js", "timelines.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Better Gemini",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
