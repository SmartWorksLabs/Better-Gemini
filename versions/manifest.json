{
  "manifest_version": 3,
  "name": "Message Versions for Gemini",
  "version": "1.0.0",
  "description": "Keep every version when you edit a Gemini prompt, and switch between them with < 1 / 2 > in the same chat. Not affiliated with Google.",
  "homepage_url": "https://github.com/SmartWorksLabs/Better-Gemini/tree/main/versions",
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["timelines.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Message Versions for Gemini",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
